{
  "name": "memory-generations-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Демонстрационный сайт-портал школьного конкурса «Мы помним связь поколений»",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "check": "npm run validate && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.13.0",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
