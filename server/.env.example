# Порт API (на Render задаётся автоматически через PORT)
API_PORT=3001

# SQLite: путь к файлу базы и каталог загрузок.
# Локально используются значения по умолчанию (server/data/app.db, server/uploads).
# На хостинге с постоянным диском укажите пути на смонтированный диск, например:
# DB_PATH=/var/data/app.db
# UPLOADS_DIR=/var/data/uploads
# DB_PATH=
# UPLOADS_DIR=

# Секрет сессий (смените при публикации, на Render генерируется автоматически)
SESSION_SECRET=replace-with-a-long-random-secret

# Учётные данные администратора (минимум 12 символов)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-at-least-12-characters

# Ниже — параметры старой MySQL-базы, нужны только для npm run migrate:mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=svyaz_pokoleniy
DB_USER=svyaz
DB_PASSWORD=svyaz_local
