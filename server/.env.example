# Порт API (на Render задаётся автоматически через PORT)
API_PORT=3001

# === База данных ===
# Локально используется файл server/data/app.db (значения ниже не нужны).
# Для постоянного хранения на хостинге создайте базу в Turso (https://app.turso.tech)
# и укажите адрес + токен — тогда данные переживают рестарты и деплои:
# TURSO_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# Путь к локальному файлу SQLite и каталог загрузок (по умолчанию
# server/data/app.db и server/uploads; на хостинге с диском укажите пути на диск)
# DB_PATH=
# UPLOADS_DIR=

# === Файлы участников ===
# Без Cloudinary файлы сохраняются на диск сервера (и теряются при рестарте
# на бесплатном плане). Для постоянного хранения создайте бесплатный аккаунт
# на https://cloudinary.com и задайте строку подключения из консоли:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# или отдельными переменными:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=svyaz-pokoleniy

# Секрет сессий (смените при публикации, на Render генерируется автоматически)
SESSION_SECRET=replace-with-a-long-random-secret

# Учётные данные администратора (минимум 12 символов)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-at-least-12-characters

# Ниже — параметры старой MySQL-базы, нужны только для npm run migrate:mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=svyaz_pokoleniy
DB_USER=svyaz
DB_PASSWORD=svyaz_local
