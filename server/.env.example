# Порт API (на Render задаётся автоматически через PORT)
API_PORT=3001

# === База данных ===
# Локально используется файл server/data/app.db (значения ниже не нужны).
# Для постоянного хранения на хостинге создайте базу в Turso (https://app.turso.tech)
# и укажите адрес + токен — тогда проекты, статусы, администратор И файлы
# участников (таблица files) переживают рестарты и деплои:
# TURSO_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# Путь к локальному файлу SQLite и каталог загрузок (по умолчанию
# server/data/app.db и server/uploads; там лежат только файлы из старых
# развёртываний — новые загрузки идут строками в таблицу files)
# DB_PATH=
# UPLOADS_DIR=

# Секрет сессий (смените при публикации, на Render генерируется автоматически)
SESSION_SECRET=replace-with-a-long-random-secret

# Учётные данные администратора (минимум 12 символов)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-at-least-12-characters

# === Два инстанса на хостинге (см. README, «Два сервиса на Render») ===
# Один и тот же сервер запускается дважды с разными флагами.
#
# Публичный сервис (сайт + API без админки, read-only токен Turso):
#   ADMIN_ROUTES=off        # /api/auth/* и /api/admin/* не существуют (404)
#   SKIP_INIT=1             # не создавать таблицы — read-only токен это запрещает
#   SUBMIT_FORWARD_URL=https://<админ-api>/api/projects
#                           # заявки с формы пересылаются на админский инстанс
#   GATEWAY_SECRET=...      # общий секрет (уходит заголовком x-gateway-secret)
#   TURSO_AUTH_TOKEN=<read-only токен>   # turso db tokens create <db> --read-only
#
# Админский сервис (полный токен, админ-роуты, инициализация базы):
#   GATEWAY_SECRET=...      # тот же секрет; без него админский API открыт
#   TURSO_AUTH_TOKEN=<полный токен>
#   SESSION_SECRET, ADMIN_USERNAME, ADMIN_PASSWORD
#
# Значение GATEWAY_SECRET должно быть одинаковым во всех сервисах,
# где оно задано: админский API — публичный сервис — панель (прокси).

# Ниже — параметры старой MySQL-базы, нужны только для npm run migrate:mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=svyaz_pokoleniy
DB_USER=svyaz
DB_PASSWORD=svyaz_local
